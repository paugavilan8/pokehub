---
import '../styles/global.css';
import { ROUTES, SITE_NAME, OG_LOCALE, ui, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Rutas de cada idioma para páginas dinámicas (por defecto, las de `route`). */
  paths?: Record<Lang, string>;
  /** Pestaña marcada en la navegación (por defecto, `route`). */
  active?: RouteKey;
}
const { lang, route, title, description, jsonLd, noindex = false, paths: customPaths, active = route } = Astro.props;
const paths = customPaths ?? ROUTES[route];
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(paths[lang]);
const fullTitle = route === 'home' && !customPaths ? title : `${title} | ${SITE_NAME}`;
const ogImage = abs(`/og-${lang}.png`);
const nav: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t.nav.sets },
  { key: 'calc', label: t.nav.calculator },
  { key: 'guide', label: t.nav.guide },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="es" href={abs(paths.es)} />
    <link rel="alternate" hreflang="en" href={abs(paths.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(paths.es)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181b20" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={ROUTES.home[lang]}>Poke<span>Hub</span></a>
        <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          <ul>
            {nav.map((n) => (
              <li><a href={ROUTES[n.key][lang]} aria-current={n.key === active ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="lang" href={paths[other]} hreflang={other} lang={other} aria-label={t.langSwitchLabel}>{other.toUpperCase()}</a>
      </div>
    </header>
    <main id="main">
      <slot name="hero" />
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container foot">
        <div class="foot-top">
          <p class="brand-foot">Poke<span>Hub</span></p>
          <ul class="foot-links">
            <li><a href={ROUTES.sources[lang]}>{t.nav.sources}</a></li>
            <li><a href={ROUTES.legal[lang]}>{t.footer.legal}</a></li>
            <li><a href={ROUTES.privacy[lang]}>{t.footer.privacy}</a></li>
            <li><a href={ROUTES.cookies[lang]}>{t.footer.cookies}</a></li>
            <li><a href={ROUTES.affiliates[lang]}>{t.footer.affiliates}</a></li>
          </ul>
        </div>
        <p>{t.footer.tagline} {t.footer.notAdvice}</p>
        <p>{t.footer.disclaimer}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { background: var(--surface); border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: stretch; gap: 28px; min-height: 60px; }
  .brand { display: flex; align-items: center; font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; color: var(--text); text-decoration: none; }
  .brand span, .brand-foot span { color: var(--accent); }
  nav { display: flex; overflow-x: auto; scrollbar-width: none; }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav li { display: flex; }
  nav a {
    display: flex; align-items: center; padding: 0 12px; white-space: nowrap;
    color: var(--text-muted); text-decoration: none; font-size: 0.95rem; font-weight: 500;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  nav a:hover { color: var(--text); }
  nav a[aria-current='page'] { color: var(--text); border-bottom-color: var(--accent); }
  .lang {
    margin-left: auto; align-self: center; font-family: var(--mono); font-size: 0.82rem; font-weight: 600;
    color: var(--text-muted); text-decoration: none; padding: 5px 9px; border: 1px solid var(--border); border-radius: 6px;
  }
  .lang:hover { color: var(--text); border-color: var(--border-strong); }
  @media (max-width: 640px) {
    .bar { flex-wrap: wrap; gap: 0 12px; }
    .brand { min-height: 52px; }
    nav { order: 3; width: 100%; margin-inline: -12px; border-top: 1px solid var(--border); }
    nav a { padding: 12px; }
  }
  .site-footer { margin-top: 80px; border-top: 1px solid var(--border); background: var(--surface); padding-block: 28px 36px; font-size: 0.85rem; color: var(--text-muted); }
  .foot p { max-width: 95ch; margin-bottom: 0.6em; }
  .foot-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 24px; margin-bottom: 12px; }
  .brand-foot { font-weight: 700; color: var(--text); font-size: 1rem; margin: 0 !important; }
  .foot-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .foot-links a { color: var(--text-muted); }
  .foot-links a:hover { color: var(--text); }
</style>
