---
import '../styles/global.css';
import SiteSearch from '../components/SiteSearch.astro';
import { ROUTES, SITE_NAME, OG_LOCALE, ui, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Rutas de cada idioma para páginas dinámicas (por defecto, las de `route`). */
  paths?: Record<Lang, string>;
  /** Pestaña marcada en la navegación (por defecto, `route`). */
  active?: RouteKey;
}
const { lang, route, title, description, jsonLd, noindex = false, paths: customPaths, active = route } = Astro.props;
const paths = customPaths ?? ROUTES[route];
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(paths[lang]);
const fullTitle = route === 'home' && !customPaths ? title : `${title} | ${SITE_NAME}`;
const ogImage = abs(`/og-${lang}.png`);
const nav: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t.nav.setsShort },
  { key: 'pokemon', label: t.nav.pokemonShort },
  { key: 'alerts', label: t.nav.alertsShort },
  { key: 'calc', label: t.nav.calculatorShort },
  { key: 'guide', label: t.nav.guideShort },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="es" href={abs(paths.es)} />
    <link rel="alternate" hreflang="en" href={abs(paths.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(paths.es)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181b20" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={ROUTES.home[lang]} aria-label={`${SITE_NAME}, ${t.nav.sets}`}>
          <svg class="mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="currentColor"/><path fill="#d0262b" d="M22 14h13a12 12 0 0 1 0 24h-6v12h-7zm7 6v12h6a6 6 0 0 0 0-12z"/></svg>
          <span class="wm">{SITE_NAME}</span>
        </a>
        <div class="search-slot"><SiteSearch lang={lang} /></div>
        <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          {nav.map((n) => <a href={ROUTES[n.key][lang]} aria-current={n.key === active ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="langs" role="group" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
          <span aria-current="true">{lang.toUpperCase()}</span>
          <a href={paths[other]} hreflang={other} lang={other} aria-label={t.langSwitchLabel}>{other.toUpperCase()}</a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot name="hero" />
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container foot">
        <div class="foot-top">
          <p class="brand-foot">{SITE_NAME}</p>
          <ul class="foot-links">
            <li><a href={ROUTES.sources[lang]}>{t.nav.sources}</a></li>
            <li><a href={ROUTES.legal[lang]}>{t.footer.legal}</a></li>
            <li><a href={ROUTES.privacy[lang]}>{t.footer.privacy}</a></li>
            <li><a href={ROUTES.cookies[lang]}>{t.footer.cookies}</a></li>
            <li><a href={ROUTES.affiliates[lang]}>{t.footer.affiliates}</a></li>
          </ul>
        </div>
        <p>{t.footer.tagline} {t.footer.notAdvice}</p>
        <p>{t.footer.disclaimer}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { background: var(--surface); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 40; }
  .bar { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 12px 28px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--text); text-decoration: none; }
  .mark { width: 28px; height: 28px; color: var(--text); }
  .wm { font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; }
  .search-slot { display: flex; justify-content: center; }
  nav { display: flex; gap: 22px; }
  nav a { color: var(--text-muted); text-decoration: none; font-size: 0.93rem; font-weight: 500; white-space: nowrap; }
  nav a:hover { color: var(--text); }
  nav a[aria-current='page'] { color: var(--text); font-weight: 700; }
  .langs { display: flex; align-items: center; gap: 2px; font-size: 0.8rem; font-weight: 650; letter-spacing: 0.04em; }
  .langs > * { padding: 4px 6px; border-radius: 5px; }
  .langs span { color: var(--text); background: var(--surface-2); }
  .langs a { color: var(--text-muted); text-decoration: none; }
  .langs a:hover { color: var(--text); }
  @media (max-width: 900px) {
    .bar { grid-template-columns: auto 1fr auto; padding-block: 10px; gap: 10px 16px; }
    .search-slot { grid-column: 1 / -1; grid-row: 2; }
    .search-slot :global(.site-search) { max-width: none; }
    nav { justify-self: end; gap: 16px; }
  }
  @media (max-width: 560px) {
    .bar { grid-template-columns: auto 1fr; }
    nav { grid-column: 1 / -1; grid-row: 3; justify-self: start; gap: 18px; padding-top: 2px; }
    .langs { justify-self: end; grid-row: 1; grid-column: 2; }
  }
  .site-footer { margin-top: 80px; border-top: 1px solid var(--border); background: var(--surface); padding-block: 28px 36px; font-size: 0.85rem; color: var(--text-muted); }
  .foot p { max-width: 95ch; margin-bottom: 0.6em; }
  .foot-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 24px; margin-bottom: 12px; }
  .brand-foot { font-weight: 800; letter-spacing: -0.03em; color: var(--text); font-size: 1rem; margin: 0 !important; }
  .foot-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .foot-links a { color: var(--text-muted); }
  .foot-links a:hover { color: var(--text); }
</style>
