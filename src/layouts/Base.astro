---
import '../styles/global.css';
import SiteSearch from '../components/SiteSearch.astro';
import MegaNav from '../components/MegaNav.astro';
import Icon from '../components/Icon.astro';
import { ROUTES, SITE_NAME, OG_LOCALE, ui, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Rutas de cada idioma para páginas dinámicas (por defecto, las de `route`). */
  paths?: Record<Lang, string>;
  /** Pestaña marcada en la navegación (por defecto, `route`). */
  active?: RouteKey;
}
const { lang, route, title, description, jsonLd, noindex = false, paths: customPaths, active = route } = Astro.props;
const paths = customPaths ?? ROUTES[route];
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(paths[lang]);
const fullTitle = route === 'home' && !customPaths ? title : `${title} | ${SITE_NAME}`;
const ogImage = abs(`/og-${lang}.png`);
const menu = lang === 'es' ? { open: 'Abrir menú', close: 'Cerrar menú' } : { open: 'Open menu', close: 'Close menu' };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="es" href={abs(paths.es)} />
    <link rel="alternate" hreflang="en" href={abs(paths.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(paths.es)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/brand/logo.webp" media="(prefers-color-scheme: light)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181b20" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="container bar">
        <button type="button" class="menu-btn" aria-expanded="false" aria-label={menu.open} data-open={menu.open} data-close={menu.close} data-menu>
          <Icon name="list" class="i-open" /><Icon name="x" class="i-close" />
        </button>
        <a class="brand" href={ROUTES.home[lang]}>
          <picture>
            <source srcset="/brand/logo-dark.webp" media="(prefers-color-scheme: dark)" />
            <img src="/brand/logo.webp" alt={SITE_NAME} width="460" height="168" />
          </picture>
        </a>
        <div class="search-slot"><SiteSearch lang={lang} /></div>
        <div class="langs" role="group" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
          <span aria-current="true">{lang.toUpperCase()}</span>
          <a href={paths[other]} hreflang={other} lang={other} aria-label={t.langSwitchLabel}>{other.toUpperCase()}</a>
        </div>
      </div>
      <MegaNav lang={lang} active={active} />
    </header>
    <main id="main">
      <slot name="hero" />
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container foot">
        <div class="foot-top">
          <p class="brand-foot">{SITE_NAME}</p>
          <ul class="foot-links">
            <li><a href={ROUTES.sources[lang]}>{t.nav.sources}</a></li>
            <li><a href={ROUTES.legal[lang]}>{t.footer.legal}</a></li>
            <li><a href={ROUTES.privacy[lang]}>{t.footer.privacy}</a></li>
            <li><a href={ROUTES.cookies[lang]}>{t.footer.cookies}</a></li>
            <li><a href={ROUTES.affiliates[lang]}>{t.footer.affiliates}</a></li>
          </ul>
        </div>
        <p>{t.footer.tagline} {t.footer.notAdvice}</p>
        <p>{t.footer.disclaimer}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { background: var(--surface); position: sticky; top: 0; z-index: 40; box-shadow: 0 1px 0 var(--border); }
  .bar { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px 32px; min-height: 72px; }
  .brand { display: block; line-height: 0; }
  .brand img { height: 50px; width: auto; }
  .search-slot { display: flex; justify-content: center; }
  .search-slot :global(.site-search) { max-width: 620px; }
  .menu-btn { display: none; }
  .langs { display: flex; align-items: center; gap: 2px; font-size: 0.8rem; font-weight: 650; letter-spacing: 0.04em; }
  .langs > * { padding: 4px 6px; border-radius: 5px; }
  .langs span { color: var(--text); background: var(--surface-2); }
  .langs a { color: var(--text-muted); text-decoration: none; }
  .langs a:hover { color: var(--text); }
  @media (max-width: 760px) {
    .bar { grid-template-columns: auto auto 1fr auto; gap: 10px 12px; min-height: 0; padding-block: 8px 10px; }
    .menu-btn { all: unset; box-sizing: border-box; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 8px; cursor: pointer; color: var(--text); margin-left: -8px; }
    .menu-btn:hover { background: var(--surface-2); }
    .menu-btn:focus-visible { outline: 2px solid var(--focus); }
    .menu-btn :global(svg) { width: 24px; height: 24px; }
    .menu-btn :global(.i-close), .menu-btn[aria-expanded='true'] :global(.i-open) { display: none; }
    .menu-btn[aria-expanded='true'] :global(.i-close) { display: block; }
    .brand img { height: 40px; }
    .langs { grid-column: 4; justify-self: end; }
    .search-slot { grid-column: 1 / -1; grid-row: 2; }
    .search-slot :global(.site-search) { max-width: none; }
  }
  .site-footer { margin-top: 80px; border-top: 1px solid var(--border); background: var(--surface); padding-block: 28px 36px; font-size: 0.85rem; color: var(--text-muted); }
  .foot p { max-width: 95ch; margin-bottom: 0.6em; }
  .foot-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 24px; margin-bottom: 12px; }
  .brand-foot { font-weight: 800; letter-spacing: -0.03em; color: var(--text); font-size: 1rem; margin: 0 !important; }
  .foot-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .foot-links a { color: var(--text-muted); }
  .foot-links a:hover { color: var(--text); }
</style>
