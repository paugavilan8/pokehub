---
// Cabecera de página sencilla: título, entradilla y una línea de detalle opcional (slot).
interface Props { title: string; lede?: string; art?: string; artAlt?: string }
const { title, lede } = Astro.props;
---
<header class="container page-head">
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <div class="extra"><slot /></div>
</header>

<style>
  .extra { flex-basis: 100%; }
  .extra :global(p) { margin: 4px 0 0; font-size: 0.88rem; color: var(--text-muted); }
</style>
