---
// Arte oficial de Pokémon (vía PokeAPI/sprites), optimizado a WebP en el build.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const art = import.meta.glob<{ default: ImageMetadata }>('../assets/pokemon/*.png', { eager: true });

interface Props { name: string; size: number; class?: string; eager?: boolean }
const { name, size, class: className, eager = false } = Astro.props;
const src = art[`../assets/pokemon/${name}.png`]?.default;
if (!src) throw new Error(`Falta el arte de ${name}`);
const label = name.charAt(0).toUpperCase() + name.slice(1);
---
<Image
  src={src}
  alt={label}
  width={size}
  height={size}
  widths={[size, Math.min(size * 2, 475)]}
  sizes={`${size}px`}
  format="webp"
  quality={82}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class:list={['poke', className]}
/>
