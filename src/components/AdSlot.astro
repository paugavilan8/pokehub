---
// Hueco de anuncio de AdSense. Sin id de editor o de bloque en src/data/affiliates.json no pinta nada.
// El consentimiento lo gestiona el aviso de privacidad de Google (AdSense > Privacidad y mensajes), que se carga con el
// script de AdSense del layout: sin consentimiento, Google sirve anuncios no personalizados o ninguno.
import { affiliates } from '../lib/market-data';
import { adSlot, type AdPlace } from '../lib/affiliates';
import type { Lang } from '../i18n/ui';

interface Props { place: AdPlace; lang: Lang }
const { place, lang } = Astro.props;
const ad = adSlot(affiliates, place);
---
{ad && (
  <aside class="ad" aria-label={lang === 'es' ? 'Publicidad' : 'Advertisement'}>
    <p class="ad-label">{lang === 'es' ? 'Publicidad' : 'Advertisement'}</p>
    <ins class="adsbygoogle" style="display:block" data-ad-client={ad.client} data-ad-slot={ad.slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}

<style>
  /* Altura reservada para que la página no salte al cargar el anuncio. */
  .ad { margin-block: 36px; }
  .ad ins { min-height: 100px; }
  .ad-label { margin: 0 0 4px; font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
</style>
