---
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import Icon from '../components/Icon.astro';
import rules from '../data/import-rules.json';
import { ROUTES, SITE_NAME, formatDate, ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const reviewed = formatDate(rules.lastReviewed, lang);

const copy = {
  es: {
    title: 'Calculadora de aduanas e IVA para cartas Pokémon en España',
    description:
      'Calcula cuánto te cuesta de verdad una caja o sobres Pokémon comprados en Japón, EE. UU. o Reino Unido: IVA, derecho de 3 €, tasa de 2 € y transportista.',
    h1: 'Lo que pagas de verdad por tus cartas importadas',
    sub: 'IVA, aduana y tasas de 2026 para compras desde Japón, EE. UU., Reino Unido y Suiza, puesto en España.',
    timelineTitle: 'Qué ha cambiado en 2026',
    timeline: [
      { date: '2026-07-01', title: 'Fin de la exención de 150 €', body: 'Cada envío de fuera de la UE de hasta 150 € paga un derecho fijo de 3 € por tipo de producto. Una caja o diez cajas de cartas cuentan igual.', status: rules.flatDuty.status },
      { date: '2026-11-01', title: 'Tasa de gestión de 2 €', body: 'Se suma a cualquier compra a distancia de fuera de la UE, valga lo que valga. Pendiente de publicación oficial: puede retrasarse.', status: rules.handlingFee.status },
      { date: null, title: 'Más de 150 €: arancel normal', body: 'Se paga un porcentaje sobre mercancía y envío (orientativo 2,7 %). Con declaración de origen desde Japón, Reino Unido o Suiza puede quedar en 0 %.', status: rules.standardDuty.status },
    ],
    always: 'Siempre',
    statusLabel: { verified: 'Verificado', secondary: 'Fuentes secundarias', pending: 'Por confirmar' },
    guideTitle: '¿Compensa importar una caja japonesa?',
    guideBody: 'Ejemplos completos, paso a paso, comparando el precio importado con el de una tienda española o europea.',
    guideCta: 'Ver la guía',
    soonTitle: 'Lo próximo en ' + SITE_NAME,
    soonBody: 'Estamos preparando estas herramientas. Las publicaremos cuando los datos estén revisados y con fuentes.',
    soon: [
      { icon: 'shield-check', title: 'Verificador de tiendas', body: 'Pega la URL de una tienda y mira si está en nuestra lista revisada, en la de alertas o sin datos.' },
      { icon: 'bell', title: 'Alertas de stock y precio', body: 'Aviso por correo cuando vuelva el stock o baje el precio de un producto sellado en tiendas de España y la UE.' },
      { icon: 'cards-three', title: '¿Merece la pena abrir este set?', body: 'Precio del sobre frente al valor esperado de sus cartas, con rangos y fecha.' },
    ],
    sourcesNote: `${t.reviewed} ${reviewed}. Cada regla enlaza a su fuente oficial.`,
    sourcesLink: 'Ver reglas y fuentes',
  },
  en: {
    title: 'EU import tax and customs calculator for Pokémon cards',
    description:
      'See what a Pokémon booster box or packs from Japan, the US or the UK really cost delivered to Spain or any EU country: VAT, the €3 duty, the €2 fee and carrier charges.',
    h1: 'What your imported cards really cost',
    sub: 'The 2026 EU VAT, duty and fees for orders from Japan, the US, the UK and Switzerland.',
    timelineTitle: 'What changed in 2026',
    timeline: [
      { date: '2026-07-01', title: 'The €150 exemption is gone', body: 'Every order up to €150 from outside the EU pays a flat €3 duty per product type. One box of cards or ten boxes count the same.', status: rules.flatDuty.status },
      { date: '2026-11-01', title: '€2 handling fee', body: 'Added to any distance sale from outside the EU, whatever its value. Still awaiting official publication, so it may be delayed.', status: rules.handlingFee.status },
      { date: null, title: 'Over €150: normal duty', body: 'A percentage of goods plus shipping (about 2.7% as a guide). With an origin statement from Japan, the UK or Switzerland it can be 0%.', status: rules.standardDuty.status },
    ],
    always: 'Always',
    statusLabel: { verified: 'Verified', secondary: 'Secondary sources', pending: 'To be confirmed' },
    guideTitle: 'Is importing a Japanese box worth it?',
    guideBody: 'Full worked examples comparing the imported price with an EU shop.',
    guideCta: 'Read the guide',
    soonTitle: 'Coming next to ' + SITE_NAME,
    soonBody: 'We are building these tools. Each one goes live once its data is reviewed and sourced.',
    soon: [
      { icon: 'shield-check', title: 'Shop checker', body: 'Paste a shop URL and see whether it is on our reviewed list, on the warning list, or unknown.' },
      { icon: 'bell', title: 'Stock and price alerts', body: 'An email when a sealed product is back in stock or drops in price at shops in Spain and the EU.' },
      { icon: 'cards-three', title: 'Is this set worth opening?', body: 'Pack price against the expected value of its cards, with ranges and dates.' },
    ],
    sourcesNote: `${t.reviewed} ${reviewed}. Every rule links to its official source.`,
    sourcesLink: 'See rules and sources',
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: copy.title,
  url: new URL(ROUTES.home[lang], Astro.site).href,
  inLanguage: lang,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  description: copy.description,
};
---
<Base lang={lang} route="home" title={copy.title} description={copy.description} jsonLd={jsonLd}>
  <div class="container">
    <section class="hero">
      <h1>{copy.h1}</h1>
      <p class="sub">{copy.sub}</p>
    </section>

    <Calculator lang={lang} />

    <p class="reviewed muted">
      <Icon name="info" /> {copy.sourcesNote} <a href={ROUTES.sources[lang]}>{copy.sourcesLink}</a>
    </p>

    <section class="timeline-sec" aria-labelledby="tl-title">
      <h2 id="tl-title">{copy.timelineTitle}</h2>
      <ol class="timeline">
        {copy.timeline.map((item) => (
          <li>
            <p class="tl-date">{item.date ? formatDate(item.date, lang) : copy.always}</p>
            <div>
              <h3>{item.title} <span class={`badge ${item.status}`}>{copy.statusLabel[item.status as keyof typeof copy.statusLabel]}</span></h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="guide-band">
      <div>
        <h2>{copy.guideTitle}</h2>
        <p>{copy.guideBody}</p>
      </div>
      <a class="btn btn-primary" href={ROUTES.guide[lang]}>{copy.guideCta} <Icon name="arrow-right" /></a>
    </section>

    <section class="soon" aria-labelledby="soon-title">
      <div class="soon-intro">
        <h2 id="soon-title">{copy.soonTitle}</h2>
        <p class="muted">{copy.soonBody}</p>
      </div>
      <ul class="soon-list">
        {copy.soon.map((s) => (
          <li>
            <span class="soon-icon"><Icon name={s.icon} /></span>
            <div>
              <h3>{s.title}</h3>
              <p class="muted">{s.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .hero { padding-block: 40px 28px; max-width: 760px; }
  @media (min-width: 768px) { .hero { padding-block: 56px 32px; } }
  .hero h1 { margin-bottom: 14px; }
  .sub { font-size: 1.15rem; color: var(--text-muted); max-width: 56ch; margin: 0; }
  .reviewed { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; font-size: 0.9rem; margin-top: 16px; }
  .reviewed :global(svg) { width: 16px; height: 16px; align-self: center; }

  .timeline-sec { margin-top: 88px; }
  .timeline { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 0; max-width: 860px; }
  .timeline li { display: grid; gap: 4px 32px; padding: 22px 0; border-top: 1px solid var(--border); }
  @media (min-width: 768px) { .timeline li { grid-template-columns: 200px 1fr; } }
  .tl-date { margin: 0; color: var(--accent); font-weight: 600; font-size: 0.95rem; }
  .timeline h3 { margin-bottom: 6px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .timeline p { margin: 0; color: var(--text-muted); max-width: 62ch; }

  .guide-band {
    margin-top: 88px; display: grid; gap: 20px; align-items: center;
    background: var(--accent-soft); border-radius: var(--radius-panel); padding: 28px;
  }
  @media (min-width: 768px) { .guide-band { grid-template-columns: 1fr auto; padding: 40px 44px; } }
  .guide-band h2 { margin-bottom: 8px; }
  .guide-band p { margin: 0; max-width: 58ch; }

  .soon { margin-top: 88px; display: grid; gap: 28px; }
  @media (min-width: 960px) { .soon { grid-template-columns: 0.8fr 1.2fr; gap: 56px; } }
  .soon-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 26px; }
  .soon-list li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; }
  .soon-icon {
    width: 44px; height: 44px; border-radius: var(--radius-control); display: grid; place-items: center;
    background: var(--surface); border: 1px solid var(--border); color: var(--accent);
  }
  .soon-icon :global(svg) { width: 22px; height: 22px; }
  .soon-list h3 { margin-bottom: 4px; }
  .soon-list p { margin: 0; }
</style>
