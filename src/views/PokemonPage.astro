---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CardDrawer from '../components/CardDrawer.astro';
import { marketIndex, pokemonName, rarityLabel, rarityShort, rarityTone, type PokemonEntry } from '../lib/market-data';
import { cardImage } from '../lib/market';
import { ROUTES, LOCALE, formatDate, type Lang } from '../i18n/ui';

interface Props { lang: Lang; pokemon: PokemonEntry }
const { lang, pokemon } = Astro.props;
const name = pokemonName(pokemon, lang);
const other = lang === 'es' ? pokemon.en : pokemon.es;
const money = new Intl.NumberFormat(LOCALE[lang], { style: 'currency', currency: 'EUR' });
const fmt = (n: number | null | undefined) => (n == null ? '-' : money.format(n));
const top = pokemon.cards[0];
const sets = new Set(pokemon.cards.map((x) => x.summary.set.id)).size;
const pricesDate = marketIndex?.pricesDate ? formatDate(marketIndex.pricesDate.slice(0, 10), lang) : null;
const paths = { es: `${ROUTES.pokemon.es}${pokemon.slug}/`, en: `${ROUTES.pokemon.en}${pokemon.slug}/` };
const n = pokemon.cards.length;

const c = {
  es: {
    title: `Cartas de ${name}: precios de todas sus cartas Pokémon TCG`,
    description: `Todas las cartas de ${name} de todas las expansiones de Pokémon TCG con su precio en Cardmarket. La más cara: ${top?.card.name} (${fmt(top?.card.price.trend)}).`,
    back: 'Todos los Pokémon',
    dex: `Número ${pokemon.dex} de la Pokédex${other !== name ? `. En inglés se llama ${other}` : ''}.`,
    lead: `${name} aparece en ${n} ${n === 1 ? 'carta' : 'cartas'} de ${sets} ${sets === 1 ? 'expansión' : 'expansiones'}. La más cara es ${top?.card.name}, de ${top?.summary.set.name}, a ${fmt(top?.card.price.trend)}. Tener una de cada costaría unos ${fmt(pokemon.total)} en Cardmarket.`,
    open: 'Ver ficha', all: 'Todas sus cartas', sort: 'Ordenar', byPrice: 'Precio', bySet: 'Expansión más reciente',
    note: pricesDate ? `Precios de tendencia de Cardmarket del ${pricesDate}. Pulsa una carta para ver su ficha.` : 'Precios de tendencia de Cardmarket. Pulsa una carta para ver su ficha.',
  },
  en: {
    title: `${name} cards: prices for every Pokémon TCG card`,
    description: `Every ${name} card from every Pokémon TCG set with its Cardmarket price. Most valuable: ${top?.card.name} (${fmt(top?.card.price.trend)}).`,
    back: 'All Pokémon',
    dex: `Pokédex number ${pokemon.dex}${other !== name ? `. In Spanish it is called ${other}` : ''}.`,
    lead: `${name} appears on ${n} ${n === 1 ? 'card' : 'cards'} across ${sets} ${sets === 1 ? 'set' : 'sets'}. The most valuable is ${top?.card.name} from ${top?.summary.set.name}, at ${fmt(top?.card.price.trend)}. Owning one of each would cost about ${fmt(pokemon.total)} on Cardmarket.`,
    open: 'View details', all: 'All its cards', sort: 'Sort', byPrice: 'Price', bySet: 'Newest set',
    note: pricesDate ? `Cardmarket trend prices from ${pricesDate}. Tap a card to see its details.` : 'Cardmarket trend prices. Tap a card to see its details.',
  },
}[lang];
---
<Base lang={lang} route="pokemon" paths={paths} title={c.title} description={c.description}>
  <div class="container">
    <a class="back" href={ROUTES.pokemon[lang]}><Icon name="arrow-left" /> {c.back}</a>

    <section class="intro">
      {top && (
        <button type="button" class="feature" data-card={top.card.id} data-set={top.summary.slug} aria-label={`${c.open}: ${top.card.name}`}>
          {top.card.image && <img src={cardImage(top.card.image, 'high')} alt={top.card.name} width="600" height="825" decoding="async" />}
        </button>
      )}
      <div class="copy">
        <h1>{name}</h1>
        <p class="dex">{c.dex}</p>
        <p class="lead">{c.lead}</p>
      </div>
    </section>

    <section class="all" aria-labelledby="all-title">
      <div class="all-head">
        <h2 id="all-title">{c.all}</h2>
        <label class="sort">{c.sort}
          <select data-sort>
            <option value="price">{c.byPrice}</option>
            <option value="date">{c.bySet}</option>
          </select>
        </label>
      </div>
      <p class="note">{c.note}</p>
      <ul class="grid" data-grid>
        {pokemon.cards.map(({ card, summary }, i) => (
          <li data-i={i} data-date={summary.set.releaseDate ?? ''}>
            <button type="button" data-card={card.id} data-set={summary.slug}>
              <span class="scan">{card.image && <img src={cardImage(card.image)} alt={card.name} loading="lazy" decoding="async" width="245" height="342" onerror="this.remove()" />}</span>
              <span class="cn">{card.name}</span>
              <span class="cs">{summary.set.name}, {lang === 'es' ? 'n.º' : 'no.'} {card.num} <span class={`rar ${rarityTone(card.rarity)}`} title={rarityLabel(card.rarity, lang)}>{rarityShort(card.rarity)}</span></span>
              <span class="cp">{fmt(card.price.trend)}</span>
            </button>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <CardDrawer lang={lang} />
</Base>

<style>
  .back { display: inline-flex; align-items: center; gap: 6px; margin-top: 24px; font-size: 0.9rem; font-weight: 500; color: var(--text-muted); text-decoration: none; }
  .back:hover { color: var(--text); }
  .back :global(svg) { width: 15px; height: 15px; }
  .intro { display: grid; gap: 28px; align-items: center; margin-top: 18px; }
  @media (min-width: 760px) { .intro { grid-template-columns: 260px 1fr; } }
  .feature { all: unset; cursor: pointer; width: min(260px, 70vw); justify-self: center; border-radius: 12px; transition: transform 0.25s var(--ease); }
  .feature:hover { transform: translateY(-4px) rotate(-1deg); }
  .feature:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .feature img { width: 100%; height: auto; border-radius: 12px; box-shadow: 0 16px 36px rgb(20 24 32 / 0.3); display: block; }
  .copy h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin-bottom: 4px; }
  .dex { color: var(--text-muted); margin: 0 0 14px; }
  .lead { font-size: 1.12rem; max-width: 60ch; margin: 0; }
  .all { margin-top: 48px; }
  .all-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px; }
  .all-head h2 { margin: 0; }
  .sort { display: flex; flex-direction: column; gap: 4px; font-size: 0.82rem; font-weight: 600; }
  .sort select { font: inherit; font-weight: 400; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface); color: var(--text); }
  .note { font-size: 0.86rem; color: var(--text-muted); margin: 6px 0 16px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px 16px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .grid button { all: unset; box-sizing: border-box; cursor: pointer; display: flex; flex-direction: column; gap: 3px; width: 100%; color: var(--text); }
  .grid button:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; border-radius: 8px; }
  .scan { display: block; aspect-ratio: 245 / 342; border-radius: 8px; background: var(--surface-2); overflow: hidden; box-shadow: 0 2px 6px rgb(20 24 32 / 0.18); transition: transform 0.2s var(--ease); margin-bottom: 6px; }
  .scan img { width: 100%; height: 100%; object-fit: cover; }
  .grid button:hover .scan { transform: translateY(-3px); }
  .cn { font-weight: 600; font-size: 0.92rem; line-height: 1.3; }
  .cs { font-size: 0.78rem; color: var(--text-muted); }
  .cp { font-weight: 700; }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const sort = document.querySelector<HTMLSelectElement>('[data-sort]');
  if (grid && sort) {
    const items = [...grid.querySelectorAll<HTMLElement>('li')];
    sort.addEventListener('change', () => {
      items.sort((a, b) => sort.value === 'date'
        ? b.dataset.date!.localeCompare(a.dataset.date!) || Number(a.dataset.i) - Number(b.dataset.i)
        : Number(a.dataset.i) - Number(b.dataset.i));
      grid.append(...items);
    });
  }
</script>
