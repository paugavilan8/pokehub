---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Poke from '../components/Poke.astro';
import PageHero from '../components/PageHero.astro';
import examples from '../data/examples.json';
import rules from '../data/import-rules.json';
import { calculate, type Origin } from '../lib/calc';
import { ROUTES, LOCALE, formatDate, ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const money = new Intl.NumberFormat(LOCALE[lang], { style: 'currency', currency: 'EUR' });
const reviewed = formatDate(rules.lastReviewed, lang);
const exampleDate = formatDate(examples.date, lang);

const worked = examples.items.map((ex) => {
  const input = { ...ex.input, origin: ex.input.origin as Origin, destination: 'ES', currency: 'EUR' as const, rate: 1, dutyRatePct: rules.standardDuty.ratePct, date: examples.date };
  const r = calculate(input);
  const params = new URLSearchParams({
    o: ex.input.origin, d: 'ES', g: String(ex.input.goods), s: String(ex.input.shipping), c: 'EUR',
    n: String(ex.input.itemTypes), cmp: String(ex.compareEu),
    ...(ex.input.ioss ? { i: '1' } : {}), ...(ex.input.preferential ? { p: '1' } : {}),
  });
  const withPref = r.regime === 'standard' && ['jp', 'uk', 'ch'].includes(ex.input.origin)
    ? calculate({ ...input, preferential: true }) : null;
  return { ...ex, r, withPref, href: `${ROUTES.home[lang]}?${params}` };
});

const L = t.calc.lines;
const EX_ART: Record<string, { art: string; tint: string }> = {
  'jp-box': { art: 'pikachu', tint: 'electric' },
  'jp-two-boxes': { art: 'greninja', tint: 'water' },
  'us-etb': { art: 'oshawott', tint: 'psychic' },
  'uk-ioss': { art: 'corviknight', tint: 'fire' },
};
const c = {
  es: {
    title: 'Aduanas e IVA al comprar cartas Pokémon fuera de la UE (2026)',
    description: 'Guía con ejemplos: qué pagas al importar cartas Pokémon a España desde Japón, EE. UU. o Reino Unido tras el derecho de 3 € y la tasa de 2 € de 2026.',
    h1: 'Aduanas e IVA al comprar cartas Pokémon fuera de la UE',
    lede: 'Desde julio de 2026 ya no hay envíos "libres de aduana" desde fuera de la UE. Esto es lo que se paga ahora, con ejemplos.',
    short: 'Resumen rápido',
    shortList: [
      'Comprar en la UE (tiendas españolas, Cardmarket con vendedores de la UE): pagas el precio y el envío. Nada más.',
      'Fuera de la UE hasta 150 € de producto: derecho fijo de 3 € por tipo de producto, IVA del 21 % y, desde noviembre de 2026, 2 € de tasa de gestión.',
      'Más de 150 €: arancel normal sobre producto y envío, más IVA. Desde Japón, Reino Unido o Suiza puede bajar a 0 % con declaración de origen.',
      'Súmale lo que cobre el transportista por tramitar la aduana. Es el coste que más varía.',
    ],
    sections: [
      { h: 'Compras dentro de la UE', p: ['Si la tienda envía desde un país de la UE (España, Portugal, Alemania, Francia...), no hay aduana. El IVA ya va incluido en el precio. Es el caso de las tiendas españolas y de la mayoría de vendedores de Cardmarket.', 'Ojo con las tiendas que se anuncian como europeas pero envían desde fuera: lo que cuenta es desde dónde sale el paquete, no el idioma de la web.'] },
      { h: 'Fuera de la UE, hasta 150 €', p: ['El límite de 150 € se mide sobre el valor del producto, sin el envío. Por debajo, desde el 1 de julio de 2026 se paga un derecho fijo de 3 € por cada tipo de producto del paquete (Reglamento (UE) 2026/382). Las cartas, sobres y cajas suelen ir en la misma partida arancelaria, así que un pedido solo de cartas paga 3 € aunque lleve varias cajas.', 'A eso se suma el IVA del 21 % sobre producto, envío y derechos. Si la tienda está en el sistema IOSS, te cobra el IVA al pagar y no en la entrega: lo verás como "IVA incluido" o "impuestos de la UE pagados".', 'Desde el 1 de noviembre de 2026 está prevista una tasa de gestión de 2 € más. Todavía no está publicada en el Diario Oficial y las fuentes no coinciden en si es por paquete o por tipo de producto: la calculadora usa la opción más cara.'] },
      { h: 'Fuera de la UE, más de 150 €', p: ['Por encima de 150 € de producto se aplica el arancel normal de la partida, que se calcula sobre producto más envío. Como referencia usamos 2,7 %, pendiente de confirmar en TARIC para cada caso.', 'Japón, Reino Unido y Suiza tienen acuerdos comerciales con la UE. Si el producto es originario de ese país y la factura incluye una declaración de origen, el arancel puede quedar en 0 %. Las cartas en inglés vendidas desde el Reino Unido normalmente no son de origen británico, así que no te cuentes con ello.', 'Por encima de 150 € la tienda no puede usar IOSS: el IVA se paga siempre en la entrega.'] },
      { h: 'La gestión del transportista', p: ['Correos, DHL, FedEx o UPS cobran por tramitar la aduana en tu nombre. Es el gasto que más cambia entre empresas y según el valor del paquete. Antes de comprar, mira qué transportista usa la tienda y busca su tarifa de gestión aduanera. En la calculadora lo puedes escribir en "Opciones avanzadas".'] },
    ],
    examplesTitle: 'Ejemplos con números',
    examplesNote: `Precios redondos inventados para explicar las reglas, no precios reales de mercado. Calculados para una importación a España el ${exampleDate}, con tasa de gestión y sin gastos del transportista.`,
    euShop: 'En una tienda de la UE',
    diffSave: 'Importar ahorra', diffMore: 'Importar cuesta',
    withPref: 'Con declaración de origen japonesa (arancel 0 %)',
    open: 'Abrir en la calculadora',
    checklistTitle: 'Antes de pagar un pedido de fuera de la UE',
    checklist: [
      '¿La tienda cobra el IVA al pagar (IOSS) o lo pagarás en la entrega?',
      '¿Qué transportista lleva el paquete y cuánto cobra por la gestión aduanera?',
      '¿El producto supera 150 € sin el envío? Si es así, valora dividir el pedido solo si son compras de verdad separadas: fraccionar a propósito un envío para evitar impuestos no está permitido.',
      '¿Cómo funcionan las devoluciones? Devolver un paquete fuera de la UE suele ser caro y los impuestos pagados no siempre se recuperan.',
    ],
    faqTitle: 'Preguntas frecuentes',
    faq: [
      { q: '¿Vale para Canarias, Ceuta y Melilla?', a: 'No. Tienen su propio régimen (IGIC en Canarias, IPSI en Ceuta y Melilla) y la calculadora no los cubre.' },
      { q: '¿Las cartas sueltas y gradeadas pagan lo mismo?', a: 'Las cartas sueltas suelen clasificarse como las cajas y sobres. Las cartas gradeadas en funda rígida podrían clasificarse de otra forma: si es una compra cara, consulta la clasificación con el transportista o un agente de aduanas.' },
      { q: '¿Y si me lo envía un amigo como regalo?', a: 'Los envíos entre particulares sin pago tienen reglas propias y esta calculadora está pensada para compras a tiendas. Consulta la información de la Agencia Tributaria sobre envíos entre particulares.' },
    ],
    sourcesNote: `${t.reviewed} ${reviewed}.`,
    sourcesLink: 'Ver todas las reglas y sus fuentes',
  },
  en: {
    title: 'EU customs and VAT on Pokémon cards bought outside the EU (2026)',
    description: 'Guide with worked examples: what you pay to import Pokémon cards into Spain or the EU from Japan, the US or the UK after the 2026 €3 duty and €2 fee.',
    h1: 'EU customs and VAT on Pokémon cards bought outside the EU',
    lede: 'Since July 2026 there is no such thing as a duty-free parcel from outside the EU. Here is what you pay now, with examples.',
    short: 'Quick summary',
    shortList: [
      'Buying inside the EU (Spanish shops, EU sellers on Cardmarket): you pay the price and shipping. Nothing else.',
      'From outside the EU, up to €150 of goods: a flat €3 duty per product type, VAT at your country\'s rate (21% in Spain) and, from November 2026, a €2 handling fee.',
      'Over €150: normal duty on goods plus shipping, plus VAT. From Japan, the UK or Switzerland it can drop to 0% with an origin statement.',
      'Add whatever the carrier charges to clear customs. It is the cost that varies most.',
    ],
    sections: [
      { h: 'Buying inside the EU', p: ['If the shop ships from an EU country (Spain, Portugal, Germany, France...), there is no customs. VAT is already in the price. That covers Spanish shops and most Cardmarket sellers.', 'Watch out for shops that look European but ship from outside the EU: what matters is where the parcel leaves from, not the language of the website.'] },
      { h: 'Outside the EU, up to €150', p: ['The €150 limit is measured on the value of the goods, without shipping. Below it, since 1 July 2026 there is a flat €3 duty for each product type in the parcel (Council Regulation (EU) 2026/382). Cards, packs and boxes usually share one tariff line, so a cards-only order pays €3 even with several boxes.', 'On top of that comes VAT on goods, shipping and duty. If the shop uses IOSS, it charges VAT at checkout instead of on delivery: you will see "VAT included" or "EU taxes paid".', 'From 1 November 2026 an extra €2 handling fee is expected. It is not yet in the Official Journal and sources disagree on whether it is per parcel or per product type: the calculator uses the more expensive reading.'] },
      { h: 'Outside the EU, over €150', p: ['Over €150 of goods the normal duty for the tariff line applies, calculated on goods plus shipping. As a guide we use 2.7%, to be confirmed in TARIC for each case.', 'Japan, the UK and Switzerland have trade agreements with the EU. If the goods originate there and the invoice carries an origin statement, duty can be 0%. English cards sold from the UK are usually not of UK origin, so do not count on it.', 'Over €150 the shop cannot use IOSS: VAT is always paid on delivery.'] },
      { h: 'The carrier clearance fee', p: ['The post office, DHL, FedEx or UPS charge to clear customs for you. It is the cost that changes most between companies and with parcel value. Before buying, check which carrier the shop uses and look up its customs clearance price. You can enter it under "Advanced options" in the calculator.'] },
    ],
    examplesTitle: 'Worked examples',
    examplesNote: `Made-up round prices to explain the rules, not real market prices. Calculated for an import into Spain on ${exampleDate}, with the handling fee and no carrier charges.`,
    euShop: 'At an EU shop',
    diffSave: 'Importing saves', diffMore: 'Importing costs',
    withPref: 'With a Japanese origin statement (0% duty)',
    open: 'Open in the calculator',
    checklistTitle: 'Before you pay for an order from outside the EU',
    checklist: [
      'Does the shop charge VAT at checkout (IOSS), or will you pay it on delivery?',
      'Which carrier delivers the parcel, and what does it charge for customs clearance?',
      'Is the order over €150 without shipping? Splitting an order on purpose to avoid tax is not allowed; only separate genuine purchases count.',
      'How do returns work? Sending a parcel back outside the EU is usually expensive and taxes paid are not always refunded.',
    ],
    faqTitle: 'Frequently asked questions',
    faq: [
      { q: 'Does it cover the Canary Islands or other special territories?', a: 'No. Places outside the EU VAT area (such as the Canary Islands, Ceuta and Melilla) have their own rules and are not covered.' },
      { q: 'Do single and graded cards pay the same?', a: 'Single cards are usually classified like boxes and packs. Graded cards in hard cases could be classified differently: for an expensive purchase, check the classification with the carrier or a customs broker.' },
      { q: 'What if a friend sends it as a gift?', a: 'Unpaid parcels between private individuals have their own rules, and this calculator is built for purchases from shops. Check your tax authority\'s guidance on gifts.' },
    ],
    sourcesNote: `${t.reviewed} ${reviewed}.`,
    sourcesLink: 'See all rules and their sources',
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: c.h1,
  description: c.description,
  inLanguage: lang,
  dateModified: rules.lastReviewed,
  mainEntityOfPage: new URL(ROUTES.guide[lang], Astro.site).href,
};
---
<Base lang={lang} route="guide" title={c.title} description={c.description} jsonLd={jsonLd}>
  <PageHero slot="hero" title={c.h1} lede={c.lede} art="dragonite" artAlt="psyduck">
    <p class="small">{c.sourcesNote} <a href={ROUTES.sources[lang]}>{c.sourcesLink}</a></p>
  </PageHero>
  <article class="container">

    <section class="summary panel-soft">
      <h2>{c.short}</h2>
      <ul>{c.shortList.map((s) => <li>{s}</li>)}</ul>
    </section>

    <div class="prose">
      {c.sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          {s.p.map((p) => <p>{p}</p>)}
        </section>
      ))}
    </div>

    <section class="examples" aria-labelledby="ex-title">
      <h2 id="ex-title">{c.examplesTitle}</h2>
      <p class="muted prose">{c.examplesNote}</p>
      <div class="ex-grid">
        {worked.map((ex) => (
          <article class="ex" id={ex.id}>
            <div class={`ex-head t-${EX_ART[ex.id].tint}`}>
              <h3>{ex.title[lang]}</h3>
              <Poke name={EX_ART[ex.id].art} size={130} class="ex-art" />
            </div>
            <p class="muted">{ex.summary[lang]}</p>
            <dl class="ex-lines">
              <dt>{L.goods}</dt><dd>{money.format(ex.r.goodsEur)}</dd>
              <dt>{L.shipping}</dt><dd>{money.format(ex.r.shippingEur)}</dd>
              <dt>{ex.r.regime === 'low-value' ? L.dutyFlat : L.duty}</dt><dd>{money.format(ex.r.duty)}</dd>
              <dt>{L.handling}</dt><dd>{money.format(ex.r.handlingFee)}</dd>
              {ex.r.vatPaidAtCheckout > 0
                ? <><dt class="sub">{L.vatIoss}</dt><dd class="sub">{money.format(ex.r.vatPaidAtCheckout)}</dd></>
                : <><dt>{L.vat} (21 %)</dt><dd>{money.format(ex.r.vat)}</dd></>}
              <dt class="tot">{L.total}</dt><dd class="tot">{money.format(ex.r.total)}</dd>
              <dt>{c.euShop}</dt><dd>{money.format(ex.compareEu)}</dd>
            </dl>
            <p class="verdict">
              {ex.r.total <= ex.compareEu
                ? <>{c.diffSave}{' '}<strong>{money.format(ex.compareEu - ex.r.total)}</strong></>
                : <>{c.diffMore}{' '}<strong>{money.format(ex.r.total - ex.compareEu)}</strong>{' '}{lang === 'es' ? 'más' : 'more'}</>}
            </p>
            {ex.withPref && <p class="muted small">{c.withPref}: <span class="num">{money.format(ex.withPref.total)}</span></p>}
            <a class="open" href={ex.href}>{c.open} <Icon name="arrow-right" /></a>
          </article>
        ))}
      </div>
    </section>

    <div class="prose">
      <section>
        <h2>{c.checklistTitle}</h2>
        <ul class="checks">{c.checklist.map((s) => <li><Icon name="check" /><span>{s}</span></li>)}</ul>
      </section>
      <section>
        <h2>{c.faqTitle}</h2>
        {c.faq.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    </div>
  </article>
</Base>

<style>
  .small { font-size: 0.9rem; }
  .panel-soft { background: var(--t-electric); border-radius: var(--radius-panel); padding: 26px 30px; margin-top: 8px; max-width: 900px; }
  .panel-soft h2 { font-size: 1.5rem; }
  .panel-soft ul { margin: 0; padding-left: 1.2em; display: grid; gap: 10px; font-size: 1.03rem; }
  .examples { margin-top: 80px; }
  .ex-grid { display: grid; gap: 22px; margin-top: 26px; }
  @media (min-width: 800px) { .ex-grid { grid-template-columns: 1fr 1fr; } }
  .ex { background: var(--surface); border-radius: var(--radius-panel); box-shadow: var(--shadow); display: flex; flex-direction: column; overflow: hidden; }
  .ex > :not(.ex-head) { margin-inline: 24px; }
  .ex-head { position: relative; min-height: 112px; padding: 22px 140px 18px 24px; margin-bottom: 16px; display: flex; align-items: flex-end; }
  .t-electric { background: var(--t-electric); } .t-water { background: var(--t-water); } .t-psychic { background: var(--t-psychic); } .t-fire { background: var(--t-fire); }
  .ex-head h3 { font-size: 1.3rem; margin: 0; }
  .ex-head :global(.ex-art) { position: absolute; right: 8px; bottom: -14px; width: 124px; filter: drop-shadow(0 10px 14px rgb(16 22 58 / 0.25)); }
  .ex-lines { display: grid; grid-template-columns: 1fr auto; margin: 4px 24px 12px; font-size: 0.95rem; }
  .ex-lines dt, .ex-lines dd { margin: 0; padding: 6px 0; }
  .ex-lines dd { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
  .ex-lines .sub { color: var(--text-muted); }
  .ex-lines .tot { border-top: 2px solid var(--text); font-weight: 800; padding-top: 9px; font-size: 1.05rem; }
  .verdict { font-weight: 600; margin-bottom: 6px; }
  .verdict strong { color: var(--ember); font-variant-numeric: tabular-nums; }
  .open { margin-top: auto !important; padding: 12px 0 24px; display: inline-flex; align-items: center; gap: 6px; font-weight: 650; }
  .open :global(svg) { width: 16px; height: 16px; }
  .checks { list-style: none; padding: 0 !important; }
  .checks li { display: grid; grid-template-columns: 26px 1fr; gap: 10px; }
  .checks :global(svg) { width: 22px; height: 22px; color: var(--ok); margin-top: 2px; }
  .faq { border-top: 1px solid var(--border); padding: 16px 0; }
  .faq summary { cursor: pointer; font-weight: 650; font-size: 1.05rem; }
  .faq p { margin: 10px 0 0; color: var(--text-muted); }
</style>
