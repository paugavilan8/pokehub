---
import '../styles/global.css';
import { SITE_NAME } from '../i18n/ui';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Página no encontrada | {SITE_NAME}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="container" style="padding-block: 96px; max-width: 640px;">
      <p class="mono muted">404</p>
      <h1>Esta página no existe</h1>
      <p class="muted">Puede que haya cambiado de dirección.</p>
      <p><a class="btn btn-primary" href="/">Ver precios de sets</a></p>
      <p lang="en" class="muted">Page not found. <a href="/en/">See set prices</a>.</p>
    </main>
  </body>
</html>
